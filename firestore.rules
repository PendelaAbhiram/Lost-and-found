rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'abhirampendela3@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidItem(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
        data.type in ['lost', 'found'] &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.desc is string && data.desc.size() > 0 && data.desc.size() <= 1000 &&
        data.location is string && data.location.size() > 0 && data.location.size() <= 200 &&
        data.date is string && data.date.size() > 0 && data.date.size() <= 50 &&
        data.status in ['open', 'solved'] &&
        data.user is string && data.user.size() > 0 && data.user.size() <= 120 &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.submittedAt is string && data.submittedAt.size() <= 64 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 10)) &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
        (!('imageData' in data) || (data.imageData == null || (data.imageData is string && data.imageData.size() <= 2000000))) &&
        (!('solvePhoto' in data) || (data.solvePhoto == null || (data.solvePhoto is string && data.solvePhoto.size() <= 2000000))) &&
        (!('solveDate' in data) || (data.solveDate == null || (data.solveDate is string && data.solveDate.size() <= 50)));
    }

    function isValidFeedback(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
        data.itemId is string && data.itemId.size() > 0 && data.itemId.size() <= 64 &&
        data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 100 &&
        data.itemType in ['lost', 'found'] &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() <= 120 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.submittedAt is string && data.submittedAt.size() <= 64 &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 10)) &&
        (!('comment' in data) || (data.comment is string && data.comment.size() <= 1000)) &&
        (!('recommendation' in data) || (data.recommendation in ['definitely', 'maybe', 'not_likely', ''])) &&
        (!('adminReviewed' in data) || data.adminReviewed is bool);
    }

    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
        (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30));
    }

    // Items collection (Lost and Found public directory)
    match /items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        isValidId(itemId) &&
        isValidItem(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().keys().hasAll(['id', 'type', 'name', 'desc', 'location', 'date', 'status', 'user', 'userId', 'submittedAt']) &&
        incoming().keys().hasOnly(['id', 'type', 'name', 'desc', 'location', 'date', 'status', 'user', 'userId', 'userName', 'phone', 'emoji', 'imageData', 'solvePhoto', 'solveDate', 'submittedAt']);

      allow update: if isSignedIn() &&
        isValidId(itemId) &&
        isValidItem(incoming()) &&
        incoming().id == existing().id &&
        incoming().userId == existing().userId &&
        incoming().submittedAt == existing().submittedAt &&
        (isAdmin() || (existing().userId == request.auth.uid && (existing().status == 'open' || isAdmin())));

      allow delete: if isSignedIn() &&
        isValidId(itemId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }

    // Feedbacks collection
    match /feedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(feedbackId) &&
        isValidFeedback(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().keys().hasAll(['id', 'itemId', 'itemName', 'itemType', 'userId', 'userEmail', 'rating', 'submittedAt']) &&
        incoming().keys().hasOnly(['id', 'itemId', 'itemName', 'itemType', 'userId', 'userEmail', 'userName', 'rating', 'tags', 'comment', 'recommendation', 'submittedAt', 'adminReviewed']);

      allow update, delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() &&
        request.auth.uid == userId &&
        isValidUser(incoming()) &&
        incoming().keys().hasAll(['uid', 'email']) &&
        incoming().keys().hasOnly(['uid', 'email', 'name', 'phone']);
      allow delete: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Test connection endpoint
    match /test/connection {
      allow read: if true;
    }
  }
}
